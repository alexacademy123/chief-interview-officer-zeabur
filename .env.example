# 环境变量配置模板
# 复制本文件为 .env，填入真实的 Key，不要提交 .env 到代码仓库

# DeepSeek API Key（必填）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 讯飞开放平台（必填）
# 获取地址：https://console.xfyun.cn/app/myapp
XF_APPID=xxxxxxxx
XF_APIKEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XF_APISECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 服务端口（可选，默认 3000）
PORT=3000
